# Retrieval engine selection.
# local-hybrid - default and only engine; openACE's own local engine. Lexical
#                (BM25) retrieval needs no credentials or network. To improve
#                semantic recall quality, bring your own reliable embedding
#                model service (and optionally a rerank model service) below;
#                retrieval then upgrades to hybrid lexical+semantic (RRF
#                fusion, optional rerank).
# (legacy "ace" upstream adapter was removed in Stage 7.)
OPENACE_ENGINE=

# --- local-hybrid semantic retrieval (bring your own models; lexical always
# --- works without any of these) ---
# Embedding endpoint type:
#   openai - OpenAI-compatible endpoint (self-hosted vLLM/TEI/Infinity/Ollama
#            or any compatible hosted service); base_url and model required,
#            API key optional.
#   voyage - Voyage-shaped endpoint (built-in base_url/model presets).
#   off    - disable the semantic path explicitly.
# Default is voyage; without an API key the semantic path simply stays
# disabled and lexical retrieval remains fully available.
OPENACE_EMBEDDING_PROVIDER=
OPENACE_EMBEDDING_BASE_URL=
OPENACE_EMBEDDING_API_KEY=
# Fallback key read by the voyage endpoint type (also used by rerank).
VOYAGE_API_KEY=
OPENACE_EMBEDDING_MODEL=
OPENACE_EMBEDDING_DIMENSION=
# Indexing-time call parameters. Budgets are unlimited by default (quality
# first); set financial guardrails on your model service / account side.
OPENACE_EMBEDDING_BATCH_SIZE=
OPENACE_EMBEDDING_MAX_CONCURRENCY=
OPENACE_EMBEDDING_RPM_BUDGET=
OPENACE_EMBEDDING_TPM_BUDGET=

# Optional rerank stage (bring your own model): tei (self-hosted TEI shape) /
# voyage (Cohere/Jina-compatible shape) / off. Default is voyage and it stays
# disabled without a key. Reranking spends model-service tokens on every query.
OPENACE_RERANK_PROVIDER=
OPENACE_RERANK_BASE_URL=
OPENACE_RERANK_API_KEY=
OPENACE_RERANK_MODEL=
OPENACE_RERANK_MAX_TOKENS=

# Shared provider HTTP behavior.
OPENACE_PROVIDER_TIMEOUT=60s
OPENACE_PROVIDER_MAX_RETRIES=5
# Optional shorter timeout for query-time provider calls (query embedding and
# rerank). Empty = inherit OPENACE_PROVIDER_TIMEOUT. Setting e.g. 15s keeps
# interactive latency bounded while builds may use a longer shared timeout.
OPENACE_QUERY_PROVIDER_TIMEOUT=

# Query-time freshness window. Empty/0 (default) = every query re-scans the
# workspace inline (always-fresh). Setting e.g. 30s serves queries from the
# last good index for up to that long, cutting per-query latency on large
# repos; background sync and explicit sync are unaffected.
OPENACE_FRESHNESS_WINDOW=

# Degrade policy when the semantic path / rerank fails:
# allow (default) - return lexical results with a leading [DEGRADED] banner.
# deny            - return an actionable error instead of degraded results.
OPENACE_RETRIEVAL_DEGRADE=
OPENACE_RERANK_DEGRADE=

# Local runtime settings.
# Use a separate cache dir when validating different accounts or tenants.
OPENACE_MODE=auto
OPENACE_CACHE_DIR=
OPENACE_CACHE_NAMESPACE=default
OPENACE_DAEMON_ADDR=
OPENACE_DAEMON_LISTEN_ADDR=127.0.0.1:8765
OPENACE_DAEMON_TOKEN=
OPENACE_DAEMON_START_TIMEOUT=10s
OPENACE_TASK_WORKERS=4
OPENACE_TASK_STORE_DIR=
OPENACE_ALLOW_REMOTE_DAEMON=
OPENACE_LOG_LEVEL=info

# Large workspace tuning.
OPENACE_MAX_FILE_BYTES=1048576

# 质量严格档(可选):on 时语义链路任一缺口直接报错而非降级放行;
# 要求已配置 embedding 服务。默认 off。
OPENACE_QUALITY_STRICT=

# 查询等待在建索引的时长上界(可选,如 30s):超时后构建继续后台推进,
# 查询按有无旧索引降级放行或返回带进度的错误。空/0=等到构建完成。
OPENACE_QUERY_BUILD_WAIT=
