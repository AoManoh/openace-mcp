# Upstream Context Engine authentication. Choose one authentication mode.

# Mode 1: full session JSON, preferred for non-interactive MCP usage.
AUGMENT_SESSION_AUTH=

# Mode 2: token + tenant URL.
AUGMENT_TOKEN=
AUGMENT_TENANT=

# Mode 3: explicit local session file.
OPENACE_SESSION_FILE=

# Experimental advanced multi-provider profile file. Leave empty for the
# recommended single-tenant path. When set, it replaces the single legacy
# credential chain above and lets tools select a provider_profile_id explicitly.
OPENACE_PROFILES_FILE=

# Retrieval engine selection (experimental).
# ace          - default; upstream Augment Context Engine (requires AUGMENT_* auth).
# local-hybrid - local engine. Lexical (BM25) retrieval needs no credentials or
#                network; configuring an embedding provider below upgrades it to
#                hybrid lexical+semantic retrieval (RRF fusion, optional rerank).
OPENACE_ENGINE=

# --- local-hybrid semantic retrieval (optional; lexical always works without keys) ---
# Embedding provider: voyage (default) / openai (self-hosted OpenAI-compatible:
# vLLM, TEI, Infinity, Ollama; API key optional) / off.
# With provider=voyage and no API key the semantic path stays disabled and
# lexical retrieval remains fully available.
OPENACE_EMBEDDING_PROVIDER=
OPENACE_EMBEDDING_BASE_URL=
OPENACE_EMBEDDING_API_KEY=
# Fallback key for the voyage provider (also used by rerank).
VOYAGE_API_KEY=
OPENACE_EMBEDDING_MODEL=
OPENACE_EMBEDDING_DIMENSION=
# Indexing-time call parameters. Budgets are unlimited by default (quality
# first); set financial guardrails in your provider dashboard instead.
OPENACE_EMBEDDING_BATCH_SIZE=
OPENACE_EMBEDDING_MAX_CONCURRENCY=
OPENACE_EMBEDDING_RPM_BUDGET=
OPENACE_EMBEDDING_TPM_BUDGET=

# Optional rerank stage: voyage (default; disabled without a key) / tei
# (self-hosted) / off. Reranking spends provider tokens on every query.
OPENACE_RERANK_PROVIDER=
OPENACE_RERANK_BASE_URL=
OPENACE_RERANK_API_KEY=
OPENACE_RERANK_MODEL=
OPENACE_RERANK_MAX_TOKENS=

# Shared provider HTTP behavior.
OPENACE_PROVIDER_TIMEOUT=60s
OPENACE_PROVIDER_MAX_RETRIES=5

# Degrade policy when the semantic path / rerank fails:
# allow (default) - return lexical results with a leading [DEGRADED] banner.
# deny            - return an actionable error instead of degraded results.
OPENACE_RETRIEVAL_DEGRADE=
OPENACE_RERANK_DEGRADE=

# Local runtime settings.
# Use a separate cache dir when validating different accounts or tenants.
OPENACE_MODE=auto
OPENACE_CACHE_DIR=
OPENACE_CACHE_NAMESPACE=default
OPENACE_DAEMON_ADDR=
OPENACE_DAEMON_LISTEN_ADDR=127.0.0.1:8765
OPENACE_DAEMON_TOKEN=
OPENACE_DAEMON_START_TIMEOUT=10s
OPENACE_TASK_WORKERS=4
OPENACE_TASK_STORE_DIR=
OPENACE_ALLOW_REMOTE_DAEMON=
OPENACE_LOG_LEVEL=info

# Large workspace tuning.
OPENACE_RETRIEVAL_TIMEOUT=90s
OPENACE_RETRIEVAL_CONCURRENCY_PER_PROVIDER=8
OPENACE_UPLOAD_BATCH_BYTES=1048576
OPENACE_FIND_MISSING_BATCH_SIZE=1000
OPENACE_MAX_FILE_BYTES=1048576
